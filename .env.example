# Development-only; do not commit real tokens or credentials.
METRIQEN_CONTROL_PORT=8000
METRIQEN_GATEWAY_PORT=8081
# The Go process binds 127.0.0.1:8081 by default when run outside Docker.

# Optional, host-native Go only. Inference disabled when unset.
# METRIQEN_UPSTREAM_URL=http://127.0.0.1:11434
# Gateway refuses non-loopback bind while local inference is enabled.

# Optional exact model-tag filter; does not pin an immutable model digest.
# METRIQEN_ALLOWED_MODELS=llama3.2:1b

# Experimental FIFO admission queue: 0 (default) -> 32 pending requests.
# Keep unset/0 for the original Ollama parallelism-only benchmark protocol.
# METRIQEN_QUEUE_DEPTH=2

# Optional developer-only FastAPI local model registry (never public).
# Both must be set to enable routes. Keep credentials and DB under reports/local/.
# METRIQEN_LOCAL_MODEL_TOKEN=<random-32-to-256-printable-ascii-bytes>
# METRIQEN_LOCAL_MODEL_DB=/absolute/path/to/metriqen-llm-serving-optimization/reports/local/models.sqlite3

# Account profile API is enabled only with the trusted OIDC verifier AND
# local PostgreSQL DSN; no browser signup/login provider is bundled.
# METRIQEN_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/metriqen_dev
# METRIQEN_OIDC_ISSUER=https://your-trusted-issuer.example/realm
# METRIQEN_OIDC_AUDIENCE=metriqen-control-api
# METRIQEN_OIDC_AUTHORIZED_PARTY=metriqen-web
# METRIQEN_OIDC_JWKS_PATH=/absolute/path/to/trusted-public-jwks.json
# Redis distributed quota/session config and load-balanced gateway not yet implemented.
