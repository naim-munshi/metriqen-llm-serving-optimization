# Development-only; do not commit real tokens or credentials.
METRIQEN_CONTROL_PORT=8000
METRIQEN_GATEWAY_PORT=8081
# The Go process binds 127.0.0.1:8081 by default when run outside Docker.

# Optional, host-native Go only. Inference disabled when unset.
# METRIQEN_UPSTREAM_URL=http://127.0.0.1:11434
# Gateway refuses non-loopback bind while local inference is enabled.

# Optional exact model-tag filter; does not pin an immutable model digest.
# METRIQEN_ALLOWED_MODELS=llama3.2:1b

# Experimental FIFO admission queue: 0 (default) -> 32 pending requests.
# Keep unset/0 for the original Ollama parallelism-only benchmark protocol.
# METRIQEN_QUEUE_DEPTH=2

# Optional developer-only FastAPI local model registry (never public).
# Both must be set to enable routes. Keep credentials and DB under reports/local/.
# METRIQEN_LOCAL_MODEL_TOKEN=<random-32-to-256-printable-ascii-bytes>
# METRIQEN_LOCAL_MODEL_DB=/absolute/path/to/metriqen-llm-serving-optimization/reports/local/models.sqlite3

# Account profile API is enabled only with the trusted OIDC verifier AND
# local PostgreSQL DSN; no browser signup/login provider is bundled.
# METRIQEN_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/metriqen_dev
# METRIQEN_OIDC_ISSUER=https://your-trusted-issuer.example/realm
# METRIQEN_OIDC_AUDIENCE=metriqen-control-api
# METRIQEN_OIDC_AUTHORIZED_PARTY=metriqen-web
# METRIQEN_OIDC_JWKS_PATH=/absolute/path/to/trusted-public-jwks.json
# Optional Redis-backed project quotas/in-flight leases, browser sessions and local HAProxy
# are implemented separately; all are DISABLED without trusted operator configuration.
# See docs/operations/project-inference-authorization.md,
# docs/operations/distributed-project-inflight.md and
# docs/operations/project-output-token-reservations.md.

# Optional Redis-backed account-mutation quota (Redis is NOT auto-provisioned).
# Requires private local Redis ACL user and separate >=32-byte HMAC key.
# METRIQEN_REDIS_URL=redis://ACL_USER:LONG_PRIVATE_PASSWORD@127.0.0.1:6379/0
# METRIQEN_RATE_LIMIT_HMAC_SECRET=<private-random-string-32-or-more-bytes>

# Optional dev-only HAProxy routing for the local Model Manager chat relay.
# Default direct Go gateway :8081; allow only :8090 with separate local HAProxy.
# METRIQEN_LOCAL_CHAT_GATEWAY_PORT=8090

# Optional browser OIDC sign-in; all three required with existing pinned JWKS.
# Real provider MUST supply RS256 ID tokens and typ=at+jwt API access tokens.
# Local development only: http://127.0.0.1:8000/auth/callback
# METRIQEN_BROWSER_AUTH_URL=https://trusted-provider.example/realms/metriqen/protocol/openid-connect/auth
# METRIQEN_BROWSER_TOKEN_URL=https://trusted-provider.example/realms/metriqen/protocol/openid-connect/token
# METRIQEN_BROWSER_REDIS_URL=redis://session_user:SECRET_AT_LEAST_16_CHARS@127.0.0.1:6379/0
# METRIQEN_BROWSER_CLIENT_SECRET=<optional-confidential-client-secret>
